---
source: src/completions.rs
expression: result.unwrap()
---
#compdef tp

autoload -U is-at-least

_tp() {
    typeset -A opt_args
    typeset -a _arguments_options
    local ret=1

    if is-at-least 5.2; then
        _arguments_options=(-s -S -C)
    else
        _arguments_options=(-s -C)
    fi

    local context curcontext="$curcontext" state line
    _arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
":: :_tp_commands" \
"*::: :->tp" \
&& ret=0
    case $state in
    (tp)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tp-command-$line[1]:"
        case $line[1] in
            (new)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':session_name:_default' \
&& ret=0
;;
(load)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':session:($(tp list))' \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
'-h[Print help]' \
'--help[Print help]' \
':shell -- The shell to generate completions for:(bash elvish fish powershell zsh)' \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
":: :_tp__subcmd__help_commands" \
"*::: :->help" \
&& ret=0

    case $state in
    (help)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:tp-help-command-$line[1]:"
        case $line[1] in
            (new)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(load)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(list)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(completions)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
(help)
_arguments "${_arguments_options[@]}" : \
&& ret=0
;;
        esac
    ;;
esac
;;
        esac
    ;;
esac
}

(( $+functions[_tp_commands] )) ||
_tp_commands() {
    local commands; commands=(
'new:Create a new session file' \
'load:Load a session' \
'list:List sessions' \
'completions:Generate shel completions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'tp commands' commands "$@"
}
(( $+functions[_tp__subcmd__completions_commands] )) ||
_tp__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'tp completions commands' commands "$@"
}
(( $+functions[_tp__subcmd__help_commands] )) ||
_tp__subcmd__help_commands() {
    local commands; commands=(
'new:Create a new session file' \
'load:Load a session' \
'list:List sessions' \
'completions:Generate shel completions' \
'help:Print this message or the help of the given subcommand(s)' \
    )
    _describe -t commands 'tp help commands' commands "$@"
}
(( $+functions[_tp__subcmd__help__subcmd__completions_commands] )) ||
_tp__subcmd__help__subcmd__completions_commands() {
    local commands; commands=()
    _describe -t commands 'tp help completions commands' commands "$@"
}
(( $+functions[_tp__subcmd__help__subcmd__help_commands] )) ||
_tp__subcmd__help__subcmd__help_commands() {
    local commands; commands=()
    _describe -t commands 'tp help help commands' commands "$@"
}
(( $+functions[_tp__subcmd__help__subcmd__list_commands] )) ||
_tp__subcmd__help__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'tp help list commands' commands "$@"
}
(( $+functions[_tp__subcmd__help__subcmd__load_commands] )) ||
_tp__subcmd__help__subcmd__load_commands() {
    local commands; commands=()
    _describe -t commands 'tp help load commands' commands "$@"
}
(( $+functions[_tp__subcmd__help__subcmd__new_commands] )) ||
_tp__subcmd__help__subcmd__new_commands() {
    local commands; commands=()
    _describe -t commands 'tp help new commands' commands "$@"
}
(( $+functions[_tp__subcmd__list_commands] )) ||
_tp__subcmd__list_commands() {
    local commands; commands=()
    _describe -t commands 'tp list commands' commands "$@"
}
(( $+functions[_tp__subcmd__load_commands] )) ||
_tp__subcmd__load_commands() {
    local commands; commands=()
    _describe -t commands 'tp load commands' commands "$@"
}
(( $+functions[_tp__subcmd__new_commands] )) ||
_tp__subcmd__new_commands() {
    local commands; commands=()
    _describe -t commands 'tp new commands' commands "$@"
}

if [ "$funcstack[1]" = "_tp" ]; then
    _tp "$@"
else
    compdef _tp tp
fi
